# ============================================================
#  Mailversand für das Anfrageformular
# ------------------------------------------------------------
#  DER EINFACHE WEG:   npm run mail:setup
#  Der Assistent fragt Anbieter, Adresse und Passwort ab,
#  legt .env.local selbst an und verschickt sofort eine
#  Testmail. Diese Datei muss man dann gar nicht anfassen.
#
#  Lieber von Hand?
#    1. Diese Datei kopieren:  copy .env.example .env.local
#    2. Variante A ODER B ausfüllen
#    3. Prüfen mit:            npm run mail:test
#  (.env.local wird nicht mit ins Repository übernommen)
# ============================================================


# ---------- Variante A: eigenes Postfach (empfohlen) ----------
#
# Es genügen drei Angaben. Host und Port kommen automatisch aus
# dem Anbieter-Kürzel.
#
# Mögliche Werte für MAIL_PRESET:
#   ionos      IONOS / 1&1
#   strato     Strato
#   hetzner    Hetzner
#   mailbox    mailbox.org
#   udag       united-domains
#   df         domainfactory
#   office365  Microsoft 365 / Outlook   (App-Passwort nötig)
#   gmail      Gmail                     (App-Passwort nötig)
#   gmx        GMX
#   webde      WEB.DE
#
# Anbieter nicht dabei? Dann MAIL_PRESET weglassen und
# MAIL_HOST / MAIL_PORT direkt eintragen (steht im Kundencenter
# des Anbieters unter "SMTP" oder "Postausgangsserver").

MAIL_PRESET=ionos
MAIL_USER=info@rissundwisch.de
MAIL_PASS=

# Optional – nur setzen, wenn nötig:
# MAIL_HOST=smtp.eigener-anbieter.de
# MAIL_PORT=587


# ---------- Variante B: Resend (nur ein Schlüssel) ----------
#
# Konto auf resend.com anlegen, Domain rissundwisch.de verifizieren
# (drei DNS-Einträge), API-Key erzeugen und hier eintragen.
# Sobald RESEND_API_KEY gesetzt ist, wird Variante A ignoriert.

# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx


# ---------- Für beide Varianten ----------

# Absender der Benachrichtigung
MAIL_FROM="Riss & Wisch Website <info@rissundwisch.de>"

# Postfach, in dem die Anfragen ankommen sollen
MAIL_TO=info@rissundwisch.de
